# Local stack values: `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8080

# Comma-separated extension IDs to hand the login session to (Web Store ID first,
# then any unpacked apps/extension/dist builds). Unset: the bridge does nothing.
NEXT_PUBLIC_POKEBROWSE_EXTENSION_ID=
